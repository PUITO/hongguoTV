<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">
    <VideoView
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />
    <LinearLayout
        android:id="@+id/overlay"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC0F1419"
        android:padding="12dp">
        <TextView android:id="@+id/title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="@color/tv_text" android:textSize="18sp" />
        <TextView android:id="@+id/meta" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="@color/tv_text_dim" android:textSize="14sp" />
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button android:id="@+id/btnPrev" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="上一集" />
            <Button android:id="@+id/btnPlayPause" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="播放/暂停" />
            <Button android:id="@+id/btnNext" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="下一集" />
            <Button android:id="@+id/btnSpeed" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="倍速" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
