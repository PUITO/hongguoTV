<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <VideoView
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- 仅标题信息，无底部按钮；倍速在系统 MediaController 上 -->
    <LinearLayout
        android:id="@+id/overlay"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:padding="20dp"
        android:background="#66000000">
        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/tv_text"
            android:textSize="22sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/tv_text_dim"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 保留 id 以免旧代码 NPE，全部 gone -->
    <Button android:id="@+id/btnPrev" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp" />
    <Button android:id="@+id/btnNext" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp" />
    <Button android:id="@+id/btnPlayPause" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp" />
    <Button android:id="@+id/btnSpeed" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp" />
</FrameLayout>
