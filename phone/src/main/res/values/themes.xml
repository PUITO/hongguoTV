<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HongguoPhone" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/hg_primary</item>
        <item name="colorPrimaryVariant">@color/hg_primary_dark</item>
        <item name="colorSecondary">@color/hg_secondary</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="android:statusBarColor">@color/hg_primary_dark</item>
        <item name="android:navigationBarColor">@color/hg_surface</item>
        <item name="android:windowBackground">@color/hg_bg</item>
        <item name="materialButtonStyle">@style/Widget.Hongguo.Button</item>
    </style>

    <style name="Widget.Hongguo.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">@dimen/btn_radius</item>
        <item name="android:minHeight">48dp</item>
        <item name="backgroundTint">@color/hg_primary</item>
    </style>

    <style name="Widget.Hongguo.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/btn_radius</item>
        <item name="strokeColor">@color/hg_secondary</item>
        <item name="android:textColor">@color/hg_secondary</item>
    </style>

    <style name="Text.Hongguo.Title">
        <item name="android:textSize">@dimen/title_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/hg_text</item>
    </style>

    <style name="Text.Hongguo.Body">
        <item name="android:textSize">@dimen/body_size</item>
        <item name="android:textColor">@color/hg_text_secondary</item>
    </style>
</resources>
