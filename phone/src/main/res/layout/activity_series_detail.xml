<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">
    <LinearLayout android:orientation="horizontal" android:padding="12dp"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/hg_primary">
        <ImageButton android:id="@+id/btnBack" android:layout_width="40dp"
            android:layout_height="40dp" android:src="@drawable/ic_arrow_back"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回" />
        <TextView android:id="@+id/detailTitle" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:textColor="#FFFFFF"
            android:textSize="16sp" android:textStyle="bold" android:gravity="center_vertical"
            android:paddingStart="8dp" android:text="剧集" />
    </LinearLayout>
    <LinearLayout android:orientation="horizontal" android:padding="12dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <ImageView android:id="@+id/cover" android:layout_width="100dp" android:layout_height="133dp"
            android:scaleType="centerCrop" android:background="#DDD" />
        <TextView android:id="@+id/meta" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:layout_marginStart="12dp"
            android:textSize="13sp" android:textColor="#444" />
    </LinearLayout>
    <TextView android:id="@+id/sourceNote" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingHorizontal="12dp"
        android:textSize="12sp" android:textColor="#E65100" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="12dp" android:text="选集" android:textStyle="bold" />
    <GridView android:id="@+id/episodeGrid" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"
        android:numColumns="4" android:horizontalSpacing="6dp" android:verticalSpacing="6dp"
        android:padding="8dp" android:stretchMode="columnWidth" />
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:padding="10dp">
        <Button android:id="@+id/btnPlayPhone" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="手机播放" />
        <Button android:id="@+id/btnPushTv" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="推送到电视" />
    </LinearLayout>
</LinearLayout>
