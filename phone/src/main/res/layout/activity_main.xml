<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hg_bg">

    <TextView
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp"
        android:background="@drawable/bg_topbar"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:text="红果推流" />

    <ViewFlipper
        android:id="@+id/flipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 0 首页：服务与绑定 -->
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:orientation="vertical" android:padding="16dp"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="连接电视" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:id="@+id/status" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:textSize="14sp" />
                <TextView android:id="@+id/bindStatus" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:textSize="15sp" android:textStyle="bold" android:textColor="@color/hg_secondary"
                    android:text="未绑定电视" />
                <TextView android:id="@+id/pairCode" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp"
                    android:textSize="28sp" android:textStyle="bold" android:gravity="center"
                    android:text="配对码 ----" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center" android:textSize="13sp" android:textColor="@color/hg_text_secondary"
                    android:text="电视端手动连接时需要填写上方配对码" />
                <Button android:id="@+id/btnStart" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="16dp"
                    android:text="① 启动推流服务" />
                <Button android:id="@+id/btnScanTv" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="② 扫描电视二维码绑定" />
                <Button android:id="@+id/btnStop" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="停止服务" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:textSize="13sp" android:textColor="@color/hg_text_secondary"
                    android:text="说明：只需扫描电视上的二维码。手机不再显示二维码。\n请保证手机与电视在同一 Wi‑Fi。" />
            </LinearLayout>
        </ScrollView>

        <!-- 1 片源 -->
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:orientation="vertical" android:padding="16dp"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="片源 / 红果" android:textSize="20sp" android:textStyle="bold" />
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="10dp">
                    <EditText android:id="@+id/searchInput" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:hint="剧名关键词" />
                    <Button android:id="@+id/btnSearch" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="搜索" />
                </LinearLayout>
                <TextView android:id="@+id/searchResult" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textSize="13sp"
                    android:textIsSelectable="true" android:minHeight="48dp" />
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <EditText android:id="@+id/seriesInput" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:hint="系列 ID" android:inputType="number" />
                    <EditText android:id="@+id/epInput" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:hint="集数" android:inputType="number" />
                    <Button android:id="@+id/btnResolve" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="解析推送" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginVertical="12dp" android:background="@color/hg_text_secondary" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="手动填写播放地址" android:textStyle="bold" />
                <EditText android:id="@+id/urlInput" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:hint="https://…mp4 / m3u8"
                    android:inputType="textUri" android:minLines="2" />
                <EditText android:id="@+id/titleInput" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:hint="标题（可选）" />
                <Button android:id="@+id/btnPush" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="推送到电视" />
                <TextView android:id="@+id/cacheStatus" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:textSize="12sp" android:textColor="@color/hg_text_secondary" />
            </LinearLayout>
        </ScrollView>

        <!-- 2 设置 -->
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:orientation="vertical" android:padding="16dp"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="播放与电视设置" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:textStyle="bold" android:text="播放方式" />
                <RadioGroup android:id="@+id/playModeGroup" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical">
                    <RadioButton android:id="@+id/modeProxy" android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="推流：手机缓存后再给电视（更稳）" android:checked="true" />
                    <RadioButton android:id="@+id/modeDirect" android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="直链：电视直接播源站（省手机流量）" />
                </RadioGroup>
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchAutoNext"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="自动连播下一集" android:checked="true" />
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchOverlay"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="电视显示控制条" android:checked="true" />
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchKeepOn"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="电视播放时保持亮屏" android:checked="true" />
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchTvLocal"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="允许电视本机按键控制" android:checked="true" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="默认倍速" />
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <Button android:id="@+id/btnDef075" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="0.75" />
                    <Button android:id="@+id/btnDef10" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="1.0" />
                    <Button android:id="@+id/btnDef125" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="1.25" />
                    <Button android:id="@+id/btnDef15" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="1.5" />
                    <Button android:id="@+id/btnDef20" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="2.0" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- 3 遥控 -->
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:orientation="vertical" android:padding="16dp"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="播放遥控" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:id="@+id/remoteHint" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:textSize="14sp" android:text="绑定电视并推送片源后可在此控制" />
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="20dp">
                    <Button android:id="@+id/btnPrev" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="56dp" android:text="上一集" />
                    <Button android:id="@+id/btnPlay" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="56dp" android:text="播放" />
                    <Button android:id="@+id/btnPause" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="56dp" android:text="暂停" />
                    <Button android:id="@+id/btnNext" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="56dp" android:text="下一集" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:text="倍速" />
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <Button android:id="@+id/btnSp075" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="0.75x" />
                    <Button android:id="@+id/btnSp10" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="1x" />
                    <Button android:id="@+id/btnSp125" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="1.25x" />
                    <Button android:id="@+id/btnSp15" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="1.5x" />
                    <Button android:id="@+id/btnSp20" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="2x" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </ViewFlipper>

    <!-- 底部导航 -->
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:background="@drawable/bg_nav"
        android:elevation="8dp" android:paddingTop="4dp" android:paddingBottom="4dp">
        <Button android:id="@+id/navHome" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="连接" style="?android:attr/borderlessButtonStyle" />
        <Button android:id="@+id/navSource" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="片源" style="?android:attr/borderlessButtonStyle" />
        <Button android:id="@+id/navSettings" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="设置" style="?android:attr/borderlessButtonStyle" />
        <Button android:id="@+id/navRemote" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="遥控" style="?android:attr/borderlessButtonStyle" />
    </LinearLayout>
</LinearLayout>
