<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hg_bg">

    <TextView
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp"
        android:background="@drawable/bg_topbar"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:text="红果推流" />

    <ViewFlipper
        android:id="@+id/flipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 0 首页：服务与绑定 -->
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:orientation="vertical" android:padding="16dp"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="连接电视" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:id="@+id/status" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:textSize="14sp" />
                <TextView android:id="@+id/bindStatus" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:textSize="15sp" android:textStyle="bold" android:textColor="@color/hg_secondary"
                    android:text="未绑定电视" />
                <TextView android:id="@+id/pairCode" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp"
                    android:textSize="28sp" android:textStyle="bold" android:gravity="center"
                    android:text="配对码 ----" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center" android:textSize="13sp" android:textColor="@color/hg_text_secondary"
                    android:text="电视端手动连接时需要填写上方配对码" />
                <Button android:id="@+id/btnStart" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="16dp"
                    android:text="① 启动推流服务" />
                <Button android:id="@+id/btnScanTv" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="② 扫描电视二维码绑定" />
                <Button android:id="@+id/btnStop" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="停止服务" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:textSize="13sp" android:textColor="@color/hg_text_secondary"
                    android:text="说明：只需扫描电视上的二维码。手机不再显示二维码。\n请保证手机与电视在同一 Wi‑Fi。" />
            </LinearLayout>
        </ScrollView>

        <!-- 1 片源 -->
        <LinearLayout android:orientation="vertical" android:layout_width="match_parent"
            android:layout_height="match_parent" android:padding="12dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="片源" android:textSize="20sp" android:textStyle="bold"
                android:textColor="@color/hg_text" />
            <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp">
                <EditText android:id="@+id/searchInput" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:hint="搜索剧名" android:imeOptions="actionSearch"
                    android:inputType="text" android:singleLine="true" />
                <Button android:id="@+id/btnSearch" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="搜索" />
            </LinearLayout>
            <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:padding="4dp">
                <TextView android:id="@+id/tabRecommend" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="36dp" android:gravity="center" android:text="推荐"
                    android:textStyle="bold" android:textColor="#FFFFFF"
                    android:background="@drawable/bg_tab_selected" android:clickable="true"
                    android:focusable="true" />
                <TextView android:id="@+id/tabHistory" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="36dp" android:gravity="center" android:text="历史"
                    android:textStyle="bold" android:textColor="#666666" android:layout_marginStart="8dp"
                    android:background="@drawable/bg_tab_normal" android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
            <TextView android:id="@+id/listHeader" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="推荐 · 点击进入 · 历史可长按删除"
                android:textSize="12sp" android:textColor="@color/hg_text_secondary" />
            <ListView android:id="@+id/seriesList" android:layout_width="match_parent"
                android:layout_height="0dp" android:layout_weight="1"
                android:divider="#EEEEEE" android:dividerHeight="1dp" />
            <TextView android:id="@+id/searchResult" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="12sp"
                android:textColor="@color/hg_text_secondary" android:visibility="gone" />
            <!-- keep hidden fields for compatibility -->
            <EditText android:id="@+id/seriesInput" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <EditText android:id="@+id/epInput" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <Button android:id="@+id/btnResolve" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <EditText android:id="@+id/urlInput" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <EditText android:id="@+id/titleInput" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <Button android:id="@+id/btnPush" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/cacheStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="@color/hg_text_secondary" />
        </LinearLayout>

        <!-- 2 设置 -->
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:orientation="vertical" android:padding="16dp"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="播放与电视设置" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:textStyle="bold" android:text="播放方式" />
                <RadioGroup android:id="@+id/playModeGroup" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical">
                    <RadioButton android:id="@+id/modeProxy" android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="推流：手机缓存后再给电视（更稳）" android:checked="true" />
                    <RadioButton android:id="@+id/modeDirect" android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="直链：电视直接播源站（省手机流量）" />
                </RadioGroup>
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchAutoNext"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="自动连播下一集" android:checked="true" />
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchOverlay"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="电视显示控制条" android:checked="true" />
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchKeepOn"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="电视播放时保持亮屏" android:checked="true" />
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchTvLocal"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="允许电视本机按键控制" android:checked="true" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="默认倍速" />
                <Spinner android:id="@+id/speedSpinner" android:layout_width="match_parent"
                    android:layout_height="48dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="推荐清晰度（公共源目前多为 360p）" />
                <Spinner android:id="@+id/qualitySpinner" android:layout_width="match_parent"
                    android:layout_height="48dp" />
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchQualityFallback"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="允许清晰度降级（关闭则只加载所选分辨率）"
                    android:checked="false" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="@color/hg_text_secondary"
                    android:text="默认关闭：选 1080 就只解析 1080，失败不自动换成 720/360 试看。" />
                
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:textStyle="bold" android:text="缓存与预取（推流流畅度）" />
                <TextView android:id="@+id/cacheStats" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp"
                    android:textSize="13sp" android:textColor="@color/hg_text_secondary"
                    android:text="缓存：计算中…" />
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="预缓存集数（0–5，连播/推TV 提前解密）" />
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp"
                    android:gravity="center_vertical">
                    <EditText android:id="@+id/inputPrefetch"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:hint="例如 2"
                        android:maxLength="1"
                        android:padding="10dp" />
                    <Button android:id="@+id/btnApplyPrefetch"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="确定" android:layout_marginStart="8dp" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="缓存上限 MB（64–4096）" />
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp"
                    android:gravity="center_vertical">
                    <EditText android:id="@+id/inputCacheMb"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:hint="例如 512"
                        android:maxLength="4"
                        android:padding="10dp" />
                    <Button android:id="@+id/btnApplyCacheMb"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="确定" android:layout_marginStart="8dp" />
                </LinearLayout>
<Button android:id="@+id/btnClearCache" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:text="清理明文缓存" />
<Button android:id="@+id/btnOpenLogs" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="20dp"
                    android:text="运行日志（查看/导出取流诊断）" />
                <Button android:id="@+id/btnClearDevice" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:text="重置播放设备身份（取流异常时点）" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:textSize="12sp"
                    android:textColor="@color/hg_text_secondary"
                    android:text="播放失败时打开日志，点「导出」分享给开发排查。" />
            </LinearLayout>
        </ScrollView>

        <!-- 3 遥控 -->
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="遥控器" android:textSize="20sp" android:textStyle="bold"
                    android:gravity="center" />

                <LinearLayout android:id="@+id/nowPlayingCard" android:orientation="vertical"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:padding="12dp"
                    android:background="@drawable/bg_status_card">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="推送状态" android:textStyle="bold" android:textSize="13sp"
                        android:textColor="@color/hg_primary" />
                    <TextView android:id="@+id/nowTitle" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="4dp"
                        android:text="暂无推送" android:textSize="15sp" android:textStyle="bold"
                        android:textColor="@color/hg_text" />
                    <TextView android:id="@+id/nowMeta" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="2dp"
                        android:textSize="12sp" android:textColor="@color/hg_text_secondary"
                        android:text="绑定电视后推送片源，此处显示正在播放信息" />
                    <TextView android:id="@+id/remoteHint" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="4dp"
                        android:textSize="12sp" android:textColor="@color/hg_text_secondary" />
                </LinearLayout>

                <FrameLayout android:layout_width="260dp" android:layout_height="260dp"
                    android:layout_gravity="center_horizontal" android:layout_marginTop="18dp"
                    android:background="@drawable/bg_remote">
                    <Button android:id="@+id/btnPlay" android:layout_width="96dp" android:layout_height="96dp"
                        android:layout_gravity="center" android:text="播放" />
                    <Button android:id="@+id/btnPause" android:layout_width="80dp" android:layout_height="44dp"
                        android:layout_gravity="center" android:layout_marginTop="72dp" android:text="暂停" />
                    <Button android:id="@+id/btnPrev" android:layout_width="72dp" android:layout_height="48dp"
                        android:layout_gravity="center_vertical|start" android:layout_marginStart="12dp"
                        android:text="上集" />
                    <Button android:id="@+id/btnNext" android:layout_width="72dp" android:layout_height="48dp"
                        android:layout_gravity="center_vertical|end" android:layout_marginEnd="12dp"
                        android:text="下集" />
                </FrameLayout>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:text="倍速" android:textStyle="bold" />
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp">
                    <TextView android:id="@+id/btnSp075" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="36dp" android:gravity="center" android:text="0.75"
                        android:background="@drawable/bg_chip_normal" android:textColor="#333"
                        android:layout_marginEnd="4dp" android:clickable="true" android:focusable="true" />
                    <TextView android:id="@+id/btnSp10" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="36dp" android:gravity="center" android:text="1.0"
                        android:background="@drawable/bg_chip_normal" android:textColor="#333"
                        android:layout_marginEnd="4dp" android:clickable="true" android:focusable="true" />
                    <TextView android:id="@+id/btnSp125" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="36dp" android:gravity="center" android:text="1.25"
                        android:background="@drawable/bg_chip_normal" android:textColor="#333"
                        android:layout_marginEnd="4dp" android:clickable="true" android:focusable="true" />
                    <TextView android:id="@+id/btnSp15" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="36dp" android:gravity="center" android:text="1.5"
                        android:background="@drawable/bg_chip_normal" android:textColor="#333"
                        android:layout_marginEnd="4dp" android:clickable="true" android:focusable="true" />
                    <TextView android:id="@+id/btnSp20" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="36dp" android:gravity="center" android:text="2.0"
                        android:background="@drawable/bg_chip_normal" android:textColor="#333"
                        android:clickable="true" android:focusable="true" />
                </LinearLayout>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:text="清晰度（推送偏好）" android:textStyle="bold" />
                <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp">
                    <TextView android:id="@+id/chipQAuto" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="36dp" android:gravity="center" android:text="自动"
                        android:background="@drawable/bg_chip_normal" android:textColor="#333"
                        android:layout_marginEnd="4dp" android:clickable="true" android:focusable="true" />
                    <TextView android:id="@+id/chipQ360" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="36dp" android:gravity="center" android:text="360p"
                        android:background="@drawable/bg_chip_normal" android:textColor="#333"
                        android:layout_marginEnd="4dp" android:clickable="true" android:focusable="true" />
                    <TextView android:id="@+id/chipQ720" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="36dp" android:gravity="center" android:text="720p"
                        android:background="@drawable/bg_chip_normal" android:textColor="#333"
                        android:layout_marginEnd="4dp" android:clickable="true" android:focusable="true" />
                    <TextView android:id="@+id/chipQ1080" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="36dp" android:gravity="center" android:text="1080p"
                        android:background="@drawable/bg_chip_normal" android:textColor="#333"
                        android:clickable="true" android:focusable="true" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

    </ViewFlipper>

    <!-- 底部导航 -->
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:background="@drawable/bg_nav"
        android:elevation="8dp" android:paddingTop="4dp" android:paddingBottom="4dp">
        <Button android:id="@+id/navHome" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="连接" style="?android:attr/borderlessButtonStyle" />
        <Button android:id="@+id/navSource" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="片源" style="?android:attr/borderlessButtonStyle" />
        <Button android:id="@+id/navSettings" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="设置" style="?android:attr/borderlessButtonStyle" />
        <Button android:id="@+id/navRemote" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="遥控" style="?android:attr/borderlessButtonStyle" />
    </LinearLayout>
</LinearLayout>
